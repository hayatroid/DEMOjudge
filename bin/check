#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)

die() {
    echo "${0##*/}: $*" >&2
    exit 1
}

type -P gleam shellcheck shfmt ruff > /dev/null \
    || exec nix develop "$root" --command "$0" "$@"
cd "$root"

sh() {
    shfmt -i 4 -ci -sr -bn -d bin/check bin/ready bin/reset bin/ship bin/stage
    shellcheck -s bash bin/check bin/ready bin/reset bin/ship bin/stage
    sed -e 's/%{[^}]*}//g' -e 's/\${[a-z_]*}/X/g' aws/node.sh.tftpl \
        | shellcheck -s bash -
}
py() {
    ruff check web/gen.py
    python3 web/gen.py --check
}
tf() {
    [[ -d aws/.terraform ]] || terraform -chdir=aws init -backend=false -input=false > /dev/null
    terraform -chdir=aws fmt -check
    terraform -chdir=aws validate -no-color > /dev/null
}
build() {
    gleam build
}
case ${1:-all} in
    sh) sh ;;
    py) py ;;
    tf) tf ;;
    build) build ;;
    all)
        sh
        py
        tf
        build
        ;;
    *) die "usage: ${0##*/} [sh|py|tf|build]" ;;
esac
