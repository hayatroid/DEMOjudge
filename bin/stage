#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)

die() {
    echo "${0##*/}: $*" >&2
    exit 1
}
out() {
    terraform -chdir="$root/aws" output -raw "$1" || die "terraform output $1 failed"
}

[[ $# -eq 0 ]] || die "takes no arguments"

OJ_TABLE=${OJ_TABLE:-$(out table)}
export OJ_TABLE
AWS_REGION=${AWS_REGION:-$(out region)}
export AWS_REGION
token=${OJ_TOKEN:-$(out token)}
api=${OJ_API:-$(out api_url)}

ask() { curl -sf --max-time 5 "$api/api/$1" || die "$api/api/$1 did not answer"; }
hosts() {
    local seen
    seen=$(ask leases)
    python3 -c 'import json, sys
print(*sorted(one["host"] for one in json.load(sys.stdin).values()
              if one["state"] == "running"))' <<< "$seen"
}
inside() {
    local id=$1 line=$2 cmd
    cmd=$(aws ssm send-command --instance-ids "$id" --document-name AWS-RunShellScript \
        --parameters "$(python3 -c 'import json, sys; print(json.dumps({"commands": [sys.argv[1]]}))' "$line")" \
        --query 'Command.CommandId' --output text)
    aws ssm wait command-executed --command-id "$cmd" --instance-id "$id" \
        || die "ssm on $id: $(aws ssm get-command-invocation --command-id "$cmd" \
            --instance-id "$id" --query StatusDetails --output text)"
    aws ssm get-command-invocation --command-id "$cmd" --instance-id "$id" \
        --query 'StandardOutputContent' --output text
}
named() {
    python3 -c 'import json, sys
answer = json.load(sys.stdin)
if "error" in answer:
    sys.exit(1)
print(answer["submission"])'
}
phase_of() {
    ask phases | python3 -c 'import json, sys
try: print(json.load(sys.stdin).get(sys.argv[1], ""))
except ValueError: pass' "$1"
}
settled() {
    local submission=$1
    for _ in {1..60}; do
        case $(phase_of "$submission") in
            completed | escalated) return 0 ;;
        esac
        sleep 1
    done
    die "$submission never settled"
}

"$root/bin/reset"
printf '%s\n' "$api/login?token=$token"

standing=""
for _ in {1..60}; do
    standing=$(hosts)
    [[ -n $standing ]] && break
    sleep 1
done
read -ra runners <<< "$standing"
[[ ${#runners[@]} -gt 0 ]] || die "the leases view names no running runner"

body=$(base64 -w0 < "$root/sources/a-ac")
for id in "${runners[@]}"; do
    answer=$(inside "$id" ". /etc/oj.env
        echo '$body' | base64 -d > /tmp/warm.c
        curl -s -X POST -H \"X-OJ-Token: \$OJ_TOKEN\" \
            http://127.0.0.1:8080/api/submit -d user=warm -d problem=a \
            --data-urlencode source@/tmp/warm.c")
    submission=$(named <<< "$answer") || die "submit was rejected: $answer"
    settled "$submission"
done

# c-slow holds each case for most of the time limit, so a judged run outlives
# the latency of an infrastructure shot and cannot complete before it lands.
answer=$(curl -sf --max-time 10 -X POST -H "X-OJ-Token: $token" "$api/api/submit" \
    --data-urlencode user=stuck --data-urlencode problem=c \
    --data-urlencode "source@$root/sources/c-slow") || die "$api/api/submit did not answer"
piece=$(named <<< "$answer") || die "submit was rejected: $answer"

# A trap is the only exposed shot; keeping one armed on the running phase
# fells whichever node picks the piece up, until the allowance runs out.
arm() {
    case $(ask traps) in
        *running*) ;;
        *)
            curl -sf --max-time 5 -X POST -H "X-OJ-Token: $token" \
                "$api/api/trap" -d trap=running -d "submission=$piece" \
                > /dev/null || die "$api/api/trap did not answer"
            ;;
    esac
}

# fis starts a felled box again two minutes after the shot, and booting back
# to a serving node takes up to another minute.
revival=180

# Each of the three allowed attempts is bounded by one revival.
deadline=$((SECONDS + 3 * revival))
while [[ $(phase_of "$piece") != escalated ]]; do
    [[ $SECONDS -lt $deadline ]] || die "$piece is $(phase_of "$piece"), not escalated"
    arm
    sleep 2
done
case $(ask traps) in
    *running*) curl -sf --max-time 5 -X POST -H "X-OJ-Token: $token" \
        "$api/api/trap" -d trap=running > /dev/null || true ;;
esac

escalations=$(ask escalations)
[[ $escalations != '[]' ]] || die "the escalations table is empty"
want=$(terraform -chdir="$root/aws" output -json instance_ids \
    | python3 -c 'import json, sys; print(*sorted(json.load(sys.stdin)))')
# The last felled box needs one more revival to stand again.
deadline=$((SECONDS + revival))
until [[ $(hosts) = "$want" ]]; do
    [[ $SECONDS -lt $deadline ]] \
        || die "the leases view stands $(hosts), terraform names $want"
    sleep 5
done
