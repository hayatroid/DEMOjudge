#include <stdio.h>

int main(void) {
    long long a, b;
    scanf("%lld %lld", &a, &b);
    long long best = 0;
    for (long long n = a; n <= b; n++) {
        long long x = n;
        long long steps = 0;
        while (x != 1) {
            x = x % 2 == 0 ? x / 2 : 3 * x + 1;
            steps++;
        }
        if (steps > best) {
            best = steps;
        }
    }
    printf("%lld\n", best);
    return 0;
}
